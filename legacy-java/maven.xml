	<goal name="crear">
		<attainGoal name="ear:install"/>
		<copy file="${maven.build.dir}/${maven.final.name}.ear" todir="${maven.jboss.deploy.dir}"/>
		<attainGoal name="jbosslibs"/>
	</goal>	
	
	<goal name="jbosslibs">
		<copy file="${maven.repo.local}/hibernate/jars/hibernate-metadata-3.0.2.jar" todir="${maven.jboss.lib.dir}"/>
		<copy file="${maven.repo.local}/hibernate/jars/hibernate-3.0.2.jar" todir="${maven.jboss.lib.dir}"/>
		<copy file="${maven.repo.local}/firebird/jars/firebirdsql-1.5.5.jar" todir="${maven.jboss.lib.dir}"/>
		<copy file="${maven.repo.local}/ehcache/jars/ehcache-1.1.jar" todir="${maven.jboss.lib.dir}"/>
		<copy file="${maven.repo.local}/c3p0/jars/c3p0-0.8.4.5.jar" todir="${maven.jboss.lib.dir}"/>
		<copy file="${maven.repo.local}/antlr/jars/antlr-2.7.5H3.jar" todir="${maven.jboss.lib.dir}"/>
		<copy file="${basedir}/common/resources/jboss/firebird-ds.xml" todir="${maven.jboss.deploy.dir}"/>
	</goal>
		
	<goal name="redeploy">
		<attainGoal name="undeploy"/>
		<attainGoal name="deploy"/>
	</goal>
	
	<goal name="p">
		<echo>${maven.repo.local}</echo>
	</goal>
