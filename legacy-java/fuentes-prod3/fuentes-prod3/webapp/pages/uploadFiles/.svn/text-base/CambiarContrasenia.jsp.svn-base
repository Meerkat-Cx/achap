<jsp:include page="bordeArriba.jsp"/>
	<FORM ACTION="../validaCbioPasswd">
		<CENTER>
		<div class="mensaje">Ingrese su usuario, su password actual y el password nuevo</div>
		<TABLE BORDER="0">
			<TR>
				<TH ALIGN="RIGHT">Usuario</TH>
				<TD><INPUT TYPE="TEXT" NAME="nombre" class="textBox" size="40"/></TD>
			</TR>
			<TR>
				<TH ALIGN="RIGHT">Password</TH>
				<TD><INPUT TYPE="PASSWORD" NAME="passwdOld" class="textBox" size="40"/></TD>
			</TR>
			<TR>
				<TH ALIGN="RIGHT">Nueva Password</TH>
				<TD><INPUT TYPE="PASSWORD" NAME="passwdNew1" class="textBox" size="40"/></TD>
			</TR>
			<TR>
				<TH ALIGN="RIGHT">Confirmar Nueva Password</TH>
				<TD><INPUT TYPE="PASSWORD" NAME="passwdNew2" class="textBox" size="40"/></TD>
			</TR>
			<TR>
				<TD></TD>
				<TABLE BORDER="0">
					<TR>
						<TD ALIGN="CENTER" style="padding: 5px"><INPUT TYPE="SUBMIT" value="Cambiar" class="boton"/></TD>
						<TD ALIGN="CENTER" style="padding: 5px"><INPUT TYPE="BUTTON" value="Volver" class="boton" onclick="window.location='ArchivosCargados.jsp'"/></TD>
					</TR>
				</TABLE>
			</TR>
		</TABLE>
		</CENTER>
	</FORM>		
<jsp:include page="bordeAbajo.jsp"/>