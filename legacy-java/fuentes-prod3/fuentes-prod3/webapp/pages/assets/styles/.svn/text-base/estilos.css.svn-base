.bordeBlanco {
	border: 2px solid #FFFFFF;
}
.texto {
	FONT-SIZE: 12px; COLOR: #424141; FONT-FAMILY: Tahoma; TEXT-ALIGN: justify
}
.textoCentrado {
	FONT-SIZE: 12px; COLOR: #424141; FONT-FAMILY: Tahoma; TEXT-ALIGN: center
}
.textoPie {

	FONT-SIZE: 11px; COLOR: #286008; FONT-FAMILY: Tahoma
}
.td {
	font-size: 9px;
	background-color: #eff3e3;
}
.Titulo {
	font-family: Tahoma;
	font-size: 14px;
	color: #424141;
	font-weight: bold;

}
.SubTitulo {

	font-family: Tahoma;
	font-size: 12px;
	color: #529b28;
	font-weight: bold;
}
.TextoVerde {
	font-family: Tahoma;
	font-size: 12px;
	color: #286008;
	background-color: #F7F9F0;
	border-top-width: 1px;
	border-right-width: 1px;
	border-bottom-width: 1px;
	border-left-width: 1px;
	border-bottom-style: none;
	border-top-color: #CCCCCC;
	border-right-color: #CCCCCC;
	border-bottom-color: #CCCCCC;
	border-left-color: #CCCCCC;
	padding: 2px;
	border-right-style: none;
	border-left-style: none;
}
.TextoError
{
	font-family: Verdana, Arial, Helvetica, sans-serif;
	font-size: 11px;
	color: #FF0000;
	text-indent: 15px;
	font-weight: bold;
	text-transform: uppercase;
	display: block;
}
