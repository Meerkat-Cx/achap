<%@ taglib uri="http://jakarta.apache.org/struts/tags-html" prefix="html"%>
<%@ taglib uri="/tags/struts-bean" prefix="bean"%>
<%@ taglib uri="/tags/struts-tiles" prefix="tiles"%>
<%@ taglib uri="/tags/struts-logic" prefix="logic"%>
<%@ taglib uri="/tags/struts-nested" prefix="nested"%>
<%@taglib uri="http://displaytag.sf.net" prefix="display" %>
<%@ taglib uri="/tags/jstl-c" prefix="c"%>


		 <TABLE width="100%" cellPadding=2 cellSpacing=2 bgcolor="#eff3e3">
                    <tr> 
					<TD height="25" bgColor=#eff3e3 class=SubTitulo colspan="4"><IMG height=15 hspace=2 
				            src="pages/assets/images/flecha_titulos3a.gif" 
					           width=11 align=absMiddle>
					
					<c:choose>
						<c:when test="${action == 'add'}">
	                   		&nbsp;El animal ha sido dado de alta correctamente en el Sistema
						</c:when>
						<c:otherwise>
									<c:choose>
										<c:when test="${action == 'update'}">
					                   		&nbsp;El animal ha sido modificado correctamente en el Sistema
										</c:when>
										<c:otherwise>
													&nbsp;El animal ha sido eliminado correctamente en el Sistema
										</c:otherwise>
									</c:choose>    
						</c:otherwise>
					</c:choose>    
					
					    	
		            </td>
            </tr>
        </TABLE>
		
<script language="JavaScript">
	  initializeMenus();	

    	
	</script> 


