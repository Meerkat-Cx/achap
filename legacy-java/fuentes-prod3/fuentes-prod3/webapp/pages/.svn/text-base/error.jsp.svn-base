<%@ taglib uri="/WEB-INF/struts-html.tld" prefix="html" %>
<%@ taglib uri="/WEB-INF/struts-bean.tld" prefix="bean" %>


<table width="100%" cellPadding=2 cellSpacing=2 bgcolor="#eff3e3">
	<tr> 
    	<td class=Titulo>
        	<font color=#529b28><img height=15 hspace=2 width=11 align=absMiddle>
            	&nbsp;Acceso denegado
			</font>
		</td>
        <td><div align=right></div></td>
	</tr>
    <tr> 
    	<td class=texto4 colSpan=2>
        	<div align=right> 
            	<table style="BORDER-TOP: #529b28 1px solid" cellSpacing=0 cellPadding=0 width="100%" border=0>
                	<tr> 
                    	<td width="30%" bgColor=#529b28><img height=2 src="pages/assets/images/pixel.gif" width=2></td>
                        <td width="70%"><IMG height=2 src="pages/assets/images/pixel.gif" width=2></td>
                    </tr>
                </table>
            </div>
        </td>
	</tr>
</table>
<!-- Fin Titulo de la pagina -->
<br/>
<h3>
	<html:messages id="msg" property="messageGlobalError" message="true">
    	<bean:write name="msg"/>
    </html:messages>
    <br />
    <html:messages id="msgException" property="exceptionMessage" message="true">
    	<bean:write name="msgException"/>
    </html:messages>
</h3>
