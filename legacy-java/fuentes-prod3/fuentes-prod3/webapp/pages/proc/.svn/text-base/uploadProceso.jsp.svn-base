
<%@ page language="java" pageEncoding="UTF-8"%>

<%@ taglib uri="http://struts.apache.org/tags-bean" prefix="bean" %>
<%@ taglib uri="http://struts.apache.org/tags-html" prefix="html" %>
<%@ taglib uri="http://struts.apache.org/tags-logic" prefix="logic" %>
<%@ taglib uri="http://struts.apache.org/tags-tiles" prefix="tiles" %>


<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html:html locale="true">
  <head>
    
    
    <title>uploadProceso.jsp</title>
    
    <meta http-equiv="pragma" content="no-cache">
    <meta http-equiv="cache-control" content="no-cache">
    <meta http-equiv="expires" content="0">    
    <meta http-equiv="keywords" content="keyword1,keyword2,keyword3">
    <meta http-equiv="description" content="This is my page">
  </head>
  
  <body>
	
	<form action="uploadProceso.do" method="POST" enctype='multipart/form-data'>
		<span class="mensaje">Seleccione un archivo XML para procesar.</span>
		<TABLE cellspacing="10px" align="center" style="margin-top: 5px; margin-bottom: 5px;">
     			<TR><TD ALIGN="right"><b>Archivo</b></TD>
				<TD ALIGN="CENTER"><input type="file" name="fichero" class="textBox boton"></TD></TR>
		</TABLE>
		<div align="center">
			<input type="submit" value="Procesar Archivo" class="boton"/>
		</div>
	</form>
</body>
</html:html>

