<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN"
	"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">


<%@ taglib uri="/tags/struts-html" prefix="html"%>
<%@ taglib uri="/tags/struts-bean" prefix="bean"%>
<%@ taglib uri="/tags/struts-logic"  prefix="logic" %>
<%@ taglib uri="/tags/struts-menu" prefix="menu" %>

<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">

<head>
    <title>Sistema Integrado de Control de Especies Lecheras (2005)</title>
    
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
     <script type="text/javascript" src="<html:rewrite forward='jsmenuExpandable'/>"></script>
</head>

<body>
<menu:useMenuDisplayer name="ListMenu" 
    bundle="org.apache.struts.action.MESSAGE" permissions="rolesAdapter">
    <menu:displayMenu name="MenuInicio"/>
    <menu:displayMenu name="MenuListados"/>
    <menu:displayMenu name="MenuBusquedas"/>    
	<menu:displayMenu name="MenuProcesar"/>   
	<menu:displayMenu name="Reportes"/>   
  	<menu:displayMenu name="Acciones"/> 
	<menu:displayMenu name="Calificaciones"/>   
	<menu:displayMenu name="Animales de Pedigree"/>   
	<menu:displayMenu name="MenuCambiarClave"/>    
    <menu:displayMenu name="MenuSalir"/>
</menu:useMenuDisplayer>


</body>
</html>


