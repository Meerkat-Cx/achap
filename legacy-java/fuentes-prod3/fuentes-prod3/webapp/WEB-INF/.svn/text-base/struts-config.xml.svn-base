		<!-- action de upload!!!!! -->
		<action path="/uploadFileAction"
			type="ar.org.sicel.upload.actions.UploadFileAction"
			name="uploadFileForm" validate="false" parameter="method">
			<forward name="message" path="/viewMessagePage.do" />

			<forward name="cambiarLote"
				path="/pages/uploadFiles/CambiarLote.jsp" redirect="false" />
			<forward name="volverStandBy"
				path="/downloadFileAction.do?method=initEnStandBy" redirect="true" />
			<forward name="loadedFiles"
				path="/downloadFileAction.do?method=initCargados" />
		</action>
		<action path="/downloadFileAction"
			type="ar.org.sicel.upload.actions.DownloadFileAction"
			name="uploadFileForm" validate="false" parameter="method">
			<forward name="success" path="/downloadProcesoPage.do" />
			<forward name="successFecha" path=".downloadProcesoFecha" />
			<forward name="cargadosEclo" path=".downloadProcesoEclo" />
			<forward name="standBy" path=".standBy" />
			<forward name="successProcesados" path="/lotesProcesadosPage.do" />
			<forward name="mostrarObservaciones" path="/mostrarObservaciones.do" />
			<forward name="mostrarObservaciones"
				path="/pages/uploadFiles/MostrarObservacionesPage.jsp" redirect="false" />

		</action>
		<action path="/mostrarObs" validate="false"
			forward=".mostrarObs" />
		<action path="/processFileAction"
			type="ar.org.sicel.upload.actions.ProcessFileAction"
			name="uploadFileForm" validate="false" parameter="method">
			<forward name="success" path="/processListFilePage.do" />
			<forward name="popup" path="/mostrarObs.do" />
			<forward name="message" path="/viewMessageProcessPage.do" />
		</action>

		<action path="/visualizarReportesAchaAction"
			type="ar.org.sicel.web.proc.VisualizarReportesAchaAction"
			name="animalForm" validate="false" parameter="method">
			<forward name="reporteMasivo" path=".reporteMasivo" />

			<forward name="success" path="/buscarAnimal.do" />
			<forward name="init"
				path="/visualizarReportesAchaAction.do?method=init" />
			<forward name="initLotes"
				path="/visualizarReportesAchaAction.do?method=initLotes" />
			<forward name="list" path="/verFichaAnimal.do" />
			<forward name="confirma" path="/confirmarBusqueda.do" />
			<forward name="confirmaLote"
				path="/confirmarBusquedaLote.do" />
			<forward name="listLote" path="/verInfoLote.do" />
			<forward name="listLotes" path="/verLotes.do" />
			<forward name="filtroLotes" path=".filtroLotes" />
			<forward name="buscarPropietarios" path=".findPropByEclo" />
		</action>
		<action path="/reportesPropietariosAchaAction"
			type="ar.org.sicel.web.proc.ReportesPropietariosAchaAction"
