		<action path="/buscarEcloAcha" validate="false"
			forward=".buscarEcloAcha" />

		<action path="/generarReporteEventosAction"
			type="ar.org.sicel.web.proc.GenerarReporteEventosAction"
			name="reporteEventosForm" validate="true" parameter="method">
			<forward name="success" path="/reporteEventos.do" />
			<forward name="initBuscarEstablecimiento"
				path="/buscarEstablecimientoAcha.do" />
			<forward name="initBuscarEclos" path="/buscarEcloAcha.do" />
			<forward name="initBuscar" path="/buscarLactancia.do" />

		</action>
		<action path="/verControl" validate="false"
			forward=".verControl" />
		<action path="/bajaControlAnimalAction"
			type="ar.org.sicel.web.proc.BajaControlAnimalAction"
