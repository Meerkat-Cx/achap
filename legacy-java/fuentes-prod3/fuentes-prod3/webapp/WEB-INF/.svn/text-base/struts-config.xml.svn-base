		<action path="/editarUsuarioValidate" parameter="method"
			type="ar.org.sicel.web.altaEdicion.actions.EdicionUsuarioAction"
			name="usuarioForm" validate="true" scope="session"
			input=".edicionUsuarioPage">
			<forward name="failure"
				path="/listarUsuario.do?method=listar" redirect="false" />
			<forward name="list" path="/listarUsuario.do?method=listar" />
			<forward name="success" path=".edicionUsuarioPage"
				redirect="false" />
			<forward name="errorMail" path=".errorUsuarioPage"
				redirect="false" />
			<forward name="buscarContactos"
				path=".filtroSeleccionContactoPage" redirect="false" />
		</action>

