<!DOCTYPE struts-config PUBLIC "-//Apache Software Foundation//DTD Struts Configuration 1.1//EN" "http://jakarta.apache.org/struts/dtds/struts-config_1_1.dtd">

<struts-config>

	<!-- ========== Data Sources Definitions =================================== -->
	<!--
		Define your Struts data sources in a file called struts-data-sources.xml and place
		it in your merge directory.
	-->

	<!-- ========== Form Bean Definitions =================================== -->
	<form-beans>

		<form-bean name="cargaMasivaForm"
			type="ar.org.sicel.web.altaEdicion.forms.CargaMasivaForm" />

		<form-bean name="ecloForm"
			type="ar.org.sicel.web.altaEdicion.forms.EcloForm" />
		<form-bean name="entidadRegionalForm"
			type="ar.org.sicel.web.altaEdicion.forms.EntidadRegionalForm" />

		<form-bean name="establecimientoForm"
			type="ar.org.sicel.web.altaEdicion.forms.EstablecimientoForm" />

		<form-bean name="propietarioForm"
			type="ar.org.sicel.web.altaEdicion.forms.PropietarioForm" />
		<form-bean name="sistemaForm"
			type="ar.org.sicel.web.altaEdicion.forms.SistemaForm" />
		<form-bean name="controlAnimalForm"
			type="ar.org.sicel.web.altaEdicion.forms.ControlAnimalForm" />
		<form-bean name="personaForm"
			type="ar.org.sicel.web.altaEdicion.forms.PersonaForm" />
		<form-bean name="conjuntoAtributosForm"
			type="ar.org.sicel.web.altaEdicion.forms.ConjuntoAtributosForm" />
		<form-bean name="atributoForm"
			type="ar.org.sicel.web.altaEdicion.forms.AtributoForm" />
		<form-bean name="valorForm"
			type="ar.org.sicel.web.altaEdicion.forms.ValorForm" />
		<form-bean name="valorAdmitidoForm"
			type="ar.org.sicel.web.altaEdicion.forms.ValorAdmitidoForm" />
		<form-bean name="animalForm"
			type="ar.org.sicel.web.altaEdicion.forms.AnimalForm" />
		<form-bean name="ubicacionForm"
			type="ar.org.sicel.web.altaEdicion.forms.UbicacionForm" />
		<form-bean name="razaForm"
			type="ar.org.sicel.web.altaEdicion.forms.RazaForm" />
		<form-bean name="atributosVariablesForm"
			type="ar.org.sicel.web.altaEdicion.forms.AtributosVariablesForm" />
		<form-bean name="pedigreeForm"
			type="ar.org.sicel.web.altaEdicion.forms.PedigreeForm" />
		<form-bean name="lactanciasGeneticasForm"
			type="ar.org.sicel.web.altaEdicion.forms.LactanciasGeneticasForm" />

		<form-bean name="loginForm"
			type="org.apache.struts.validator.DynaValidatorActionForm">
			<form-property name="userName" type="java.lang.String" />
			<form-property name="password" type="java.lang.String" />
		</form-bean>

		<form-bean name="procProcesForm"
			type="org.apache.struts.validator.DynaValidatorActionForm">
			<form-property name="procProcesId" type="java.lang.Long"
				initial="" />
			<form-property name="procProces"
				type="ar.org.sicel.persistence.ProcProces" />
			<form-property name="mensajes" type="java.util.Set" />
		</form-bean>

		<form-bean name="procLoteForm"
			type="org.apache.struts.validator.DynaValidatorActionForm">
			<form-property name="procLoteId" type="java.lang.Long"
				initial="" />
			<form-property name="procLote"
				type="ar.org.sicel.persistence.ProcLote" />
		</form-bean>

		<form-bean name="procEstablecimientoForm"
			type="org.apache.struts.validator.DynaValidatorActionForm">
			<form-property name="procEstablecimientoId"
				type="java.lang.Long" initial="" />
			<form-property name="procEstablecimiento"
				type="ar.org.sicel.persistence.ProcEstablecimiento" />
			<form-property name="procEvtEstArrayList"
				type="ar.org.sicel.web.util.ArrayListWithGetItem" />
		</form-bean>

		<form-bean name="procAnimalForm"
			type="org.apache.struts.validator.DynaValidatorActionForm">
			<form-property name="procAnimalId" type="java.lang.Long"
				initial="" />
			<form-property name="procAnimal"
				type="ar.org.sicel.persistence.ProcAnimal" />
			<form-property name="procEvtAnimalArrayList"
				type="ar.org.sicel.web.util.ArrayListWithGetItem" />
		</form-bean>

		<!-- son de upload ex Uploadprocess -->

		<form-bean name="uploadFileForm"
			type="ar.org.sicel.upload.forms.UploadFileForm">
		</form-bean>

		<form-bean name="usuarioForm"
			type="ar.org.sicel.web.altaEdicion.forms.UsuarioForm" />


		<form-bean name="estanciaForm"
			type="ar.org.sicel.web.altaEdicion.forms.EstanciaForm" />

		<form-bean name="cambiarClaveForm"
			type="ar.org.sicel.web.login.CambiarClaveForm" />


		<form-bean name="reportesEcloForm"
			type="ar.org.sicel.web.find.ReportesEcloForm" />
		<form-bean name="reporteEventosForm"
			type="ar.org.sicel.web.find.ReporteEventosForm" />

		<form-bean name="ecloBuscarForm"
			type="ar.org.sicel.web.find.EcloBuscarForm" />

		<form-bean name="filtroCalificacionForm"
			type="ar.org.sicel.web.altaEdicion.forms.FiltroCalificacionForm" />

		<form-bean name="calificacionForm"
			type="ar.org.sicel.web.altaEdicion.forms.CalificacionForm" />
		<form-bean name="reporteAchaForm"
			type="ar.org.sicel.web.proc.ReporteAchaForm" />
		<form-bean name="cambioRegistroForm"
			type="ar.org.sicel.web.altaEdicion.forms.CambioRegistroForm" />
		<form-bean name="intercambioForm"
			type="ar.org.sicel.web.proc.IntercambioForm" />
		<form-bean name="sinonimosForm"
			type="ar.org.sicel.web.proc.SinonimosForm" />
		<form-bean name="tiposRegistroForm"
			type="ar.org.sicel.web.find.TiposRegistroForm" />
		<form-bean name="centroDeComputoForm"
			type="ar.org.sicel.web.altaEdicion.forms.CentroDeComputoForm" />
		<form-bean name="busquedaEstanciaForm"
			type="ar.org.sicel.web.find.BusquedaEstanciaForm" />

		<form-bean name="busquedaCentroDeComputoForm"
			type="ar.org.sicel.web.find.BusquedaCentroDeComputoForm" />
		<form-bean name="buscarProcesosForm"
			type="ar.org.sicel.web.find.BuscarProcesosForm" />
		
		<form-bean name="actualizacionSicelUnoForm"
			type="ar.org.sicel.web.altaEdicion.forms.ActualizacionSicelUnoForm" />
		<form-bean name="informeProcesoForm"
			type="ar.org.sicel.web.proc.InformeProcesoForm" />

		<form-bean name="informeProcesoForm"
			type="ar.org.sicel.web.proc.InformeProcesoForm" />		
			
		<form-bean name="formularioC89Form"
				type="ar.org.sicel.web.altaEdicion.forms.FormularioC89Form" />

	
		<form-bean name="informeTambosCriasForm"
				type="ar.org.sicel.web.find.InformeTambosCriasForm" />
				
		<form-bean name="reporteIcarForm"
				type="ar.org.sicel.web.find.ReporteIcarForm" />
				
		<form-bean name="reporteInscriptosForm"
				type="ar.org.sicel.web.find.ReporteInscriptosForm" />
				
		<form-bean name="estadisticoLactanciaForm"
				type="ar.org.sicel.web.find.EstadisticoLactanciaForm" />

	<form-bean name="reporteNombreHBAForm"
				type="ar.org.sicel.web.find.ReporteNombreHBAForm" />

</form-beans>


	<!-- ========== Global Exceptions Definitions =================================== -->
	<!--
		Define your exceptions in a file called global-exceptions.xml and place
		it in your merge directory.
	-->

	<!-- ========== Global Forward Definitions =================================== -->
	<!-- Global Forward -->
	<global-forwards>
		<!-- default forwards -->
		<forward name="display" path="/pages/assets/styles/display.css" />
		<forward name="menuExpandable"
			path="/pages/assets/styles/menuExpandable.css" />
		<forward name="jsmenuExpandable"
			path="/pages/assets/js/menuExpandable.js" />
		<forward name="estilos" path="/pages/assets/styles/estilos.css" />
		<forward name="extremeComponents"
			path="/pages/assets/styles/extremecomponents.css" />
		<forward name="extremeComponentsJS"
			path="/pages/assets/js/extremecomponents.js" />
		<forward name="md5JS" path="/pages/assets/js/md5.js" />

		<!-- Default forward to "Welcome" action -->
		<!-- Demonstrates using index.jsp to forward -->
		<forward name="main" path="/main.do" />
		<forward name="login" path="/.enterLogin" />
	</global-forwards>

	<!-- ========== Action Mapping Definitions =================================== -->
	<action-mappings>
		<action path="/informeProcesosAction"
			type="ar.org.sicel.web.proc.InformeProcesosAction"
			name="informeProcesoForm" parameter="method" validate="false">
			<forward name="init" path=".informeProceso" redirect="false" />

		</action>
		<action path="/realizarUnionSinonimosAction"
			type="ar.org.sicel.web.proc.RealizarUnionSinonimosAction"
			name="sinonimosForm" parameter="method" validate="false">
			<forward name="init" path=".unirSinonimos" redirect="false" />

		</action>
		<action path="/listarTiposRegistroAction"
			type="ar.org.sicel.web.find.ListarTiposRegistroAction"
			name="tiposRegistroForm" validate="true" parameter="method">
			<forward name="list" path=".listaTiposPage" />
			<forward name="success" path=".tipoRegistroFormPage"
				redirect="false" />
		</action>
		<action path="/cargaMasivaAction"
			type="ar.org.sicel.web.altaEdicion.actions.CargaMasivaAction"
			name="cargaMasivaForm" parameter="method" validate="false">
			<forward name="init" path=".filtroCargaMasiva" />
			<forward name="initCambioRP" path=".filtroCargaCambiosRP" />
			<forward name="errorMail" path=".errorCargaMasivaPage"
				redirect="false" />
		</action>
		
		<action path="/actualizacionSicelUno"
			type="ar.org.sicel.web.altaEdicion.actions.ActualizacionSicelUnoAction"
			name="actualizacionSicelUnoForm" parameter="method" validate="false">
			<forward name="init" path=".initActualizacionSicelUno" />
			<forward name="mostrarDatos" path=".datosAnimalActualizacionSicelUno" />
			<forward name="cambiarMadre" path=".cambioMadreAnimalActualizacionSicelUno" />
			<forward name="cambiarPadre" path=".cambioPadreAnimalActualizacionSicelUno" />
		</action>

		<action path="/reportesAchaAction"
			type="ar.org.sicel.web.proc.ReportesAchaAction"
			name="reporteAchaForm" parameter="method" validate="false">
			<forward name="success" path=".filtrosFacturacion"
				redirect="false" />
			<forward name="initBuscarPropietario"
				path=".buscarPropietarioFacturacion" redirect="false" />
			<forward name="failure" path=".datosBuscarCalif"
				redirect="false" />
			<forward name="initBuscar" path=".datosBuscarCalif"
				redirect="false" />

		</action>

		<action path="/intercambiarEntrePropietariosAction"
			type="ar.org.sicel.web.proc.IntercambiarEntrePropietariosAction"
			name="intercambioForm" parameter="method" validate="false">
			<forward name="success" path=".filtrosFacturacion"
				redirect="false" />
			<forward name="initBuscarPropietario"
				path=".buscarPropietarioFacturacion" redirect="false" />
			<forward name="failure" path=".datosBuscarCalif"
				redirect="false" />
			<forward name="initBuscar" path=".datosBuscarCalif"
				redirect="false" />
			<forward name="init" path=".intercambioEntreProp"
				redirect="false" />

		</action>
		<action path="/filtrarCalificacionAction"
			type="ar.org.sicel.web.altaEdicion.actions.FiltrarCalificacionAction"
			name="filtroCalificacionForm" input=".datosBuscarCalif"
			parameter="method" validate="false">
			<forward name="success" path=".calificacionTable" />
			<forward name="main" path=".main" redirect="false" />
			<forward name="failure" path=".datosBuscarCalif"
				redirect="false" />
			<forward name="initBuscar" path=".datosBuscarCalif"
				redirect="false" />
			<forward name="initBuscarEstancia"
				path=".listaEstanciasPorNombre" />

		</action>
		<action path="/edicionAnimalPedigreeAction" parameter="method"
			type="ar.org.sicel.web.altaEdicion.actions.EdicionAnimalPedigreeAction"
			name="pedigreeForm" validate="false" scope="session">
			<forward name="add" path=".pedigreeFormPage"
				redirect="false" />
			<forward name="initBuscarAnimal"
				path=".buscarPadresPedigree" />
			<forward name="initAddEspecial"
				path="/edicionAnimalPedigreeAction.do?method=initAddEspecial" />
			<forward name="initBuscarTambo" path=".buscarTamboPedigree" />
			<forward name="initBuscarTamboCriador"
				path=".buscarTamboPedigree" />
			<forward name="initBuscarProp"
				path=".buscarPropietarioPedigree" />
			<forward name="initAdd"
				path="/edicionAnimalPedigreeAction.do?method=initAdd" />
			<forward name="initRegistros" path=".registroTable" />
			<forward name="initComentarios" path=".comentarioTable" />
			<forward name="initAddRegistro" path=".registroPedFormPage" />
			<forward name="initAddComentario"
				path=".comentarioPedFormPage" />
			<forward name="initBuscar" path=".buscarAnimalPedigree" />
			<forward name="initPadron" path=".padronPedigree" />
			<forward name="listadoPadron" path=".listadoPadron" />
			<forward name="comunicacion" path=".comunicacion" />



		</action>
		<action path="/descargaDocumentacionAction" parameter="method"
			type="ar.org.sicel.web.altaEdicion.actions.DescargaDocumentacionAction"
			name="pedigreeForm" validate="false" scope="session">
			<forward name="listadoDOC" path=".listadoDOC" />




		</action>

		<action path="/cambioRegistroAction"
			type="ar.org.sicel.web.altaEdicion.actions.CambioRegistroAction"
			name="cambioRegistroForm" parameter="method" validate="false">
			<forward name="cambio" path="/buscarAnim.do?method=porId" />
			<forward name="init" path=".cambioRegistro"
				redirect="false" />
		</action>
		<action path="/altaCalificacionAction"
			type="ar.org.sicel.web.altaEdicion.actions.AltaCalificacionAction"
			name="calificacionForm" parameter="method" validate="true">
			<forward name="main" path=".main" redirect="false" />
			<forward name="initValores" path=".seteoCalificacion" />
			<forward name="initBuscarPropietario"
				path=".buscarPropietarioNombre" />
			<forward name="initBuscarEstablecimiento"
				path=".buscarEstablecimientoNombre" />
			<forward name="buscarAnimal"
				path=".buscarAnimalCalificacion" />
			<forward name="boleta" path=".boleta" />
			<forward name="boletaM1" path=".boletaM1" />
			<forward name="boletaM2" path=".boletaM2" />
			<forward name="boletaM3" path=".boletaM3" />
			<forward name="boletaM3View" path=".boletaM3View" />
			<forward name="iniciar"
				path="/altaCalificacionAction.do?method=initSetValores"
				redirect="true" />
			<forward name="init"
				path="/altaCalificacionAction.do?method=initEspecial"
				redirect="true" />
			<forward name="initAdd"
				path="/altaCalificacionAction.do?method=initAdd" redirect="true" />
			<forward name="initAddM3"
				path="/altaCalificacionAction.do?method=initAddM3" redirect="true" />
			<forward name="filtro"
				path="/filtrarCalificacionAction.do?method=initBuscar"
				redirect="false" />
			<forward name="seguir"
				path="/altaCalificacionAction.do?method=seguirCargando"
				redirect="true" />
			<forward name="boletaRemove" path=".remove" />


		</action>

		<action path="/listarRazas"
			type="ar.org.sicel.web.find.ListarRazasAction" name="razaForm"
			validate="false" parameter="method">
			<forward name="list" path=".listaRazaPage" />
			<forward name="agregar" path=".edicionRazaPage" redirect="true" />
		</action>

		<action path="/editarRazaValidate" parameter="method"
			type="ar.org.sicel.web.altaEdicion.actions.EdicionRazaAction"
			name="razaForm" validate="true" scope="session"
			input=".edicionRazaPage">
			<forward name="failure" path="/listarRazas.do?method=listar"
				redirect="false" />
			<forward name="list" path="/listarRazas.do?method=listar"
				redirect="true" />
			<forward name="success" path=".edicionRazaPage"
				redirect="true" />

		</action>

		<action path="/listarSistemas"
			type="ar.org.sicel.web.find.ListarSistemasAction" name="sistemaForm"
			validate="false" parameter="method">
			<forward name="list" path=".listaSistemaPage" />
		</action>

		<action path="/editarSistemaValidate" parameter="method"
			type="ar.org.sicel.web.altaEdicion.actions.EdicionSistemaAction"
			name="sistemaForm" validate="true" scope="session"
			input=".edicionSistemaPage">
			<forward name="failure"
				path="/listarSistemas.do?method=listar" redirect="false" />
			<forward name="list"
				path="/listarSistemas.do?method=listar" />
			<forward name="success" path=".edicionSistemaPage"
				redirect="true" />

		</action>



		<action path="/listarEstancias"
			type="ar.org.sicel.web.find.ListarEstanciaAction" name="estanciaForm"
			validate="false" parameter="method">
			<forward name="init" path=".listaEstanciaPage"
				redirect="false" />
		</action>
		<action path="/listarEstablecimientoAction"
			type="ar.org.sicel.web.find.ListarEstablecimientoAction"
			name="establecimientoForm" validate="false" parameter="method">

			<forward name="list" path=".listaEstablecimientoPage" />
		</action>
		<action path="/editarEstablecimientoValidate" parameter="method"
			type="ar.org.sicel.web.altaEdicion.actions.EdicionEstablecimientoAction"
			name="establecimientoForm" validate="true" scope="session"
			input=".edicionEstablecimientoPage">
			<forward name="failure"
				path="/editarEstablecimientoValidate.do?method=init"
				redirect="true" />
			<forward name="list" path=".listaEstablecimientoPage" />
			<forward name="init" path=".listaEstablecimientoPage"
				redirect="true" />
			<forward name="mostrarId" path=".mostrarIdPage"
				redirect="true" />
			<forward name="listar"
				path="/editarEstablecimientoValidate.do?method=init"
				redirect="true" />
			<forward name="success" path=".edicionEstablecimientoPage"
				redirect="true" />
			<forward name="initBuscarEstancia" path=".listaEstancias" />
			<forward name="initBuscarEclo" path=".listaEclos" />
			<forward name="errorMail" path=".errorEstablecimientoPage"
				redirect="false" />

		</action>
		<action path="/editarPropietarioValidate" parameter="method"
			type="ar.org.sicel.web.altaEdicion.actions.EdicionPropietarioAction"
			name="propietarioForm" validate="true" scope="session"
			input=".edicionPropietarioPage">
			<forward name="failure"
				path="/editarPropietarioValidate.do?method=init" redirect="false" />
			<forward name="list" path=".listaPropietarioPage" />
			<forward name="init" path=".listaPropietarioPage" />
			<forward name="listar"
				path="/editarPropietarioValidate.do?method=init" />
			<forward name="success" path=".edicionPropietarioPage"
				redirect="true" />
			<forward name="agregarNroSRA" path=".agregarNroSRA" />
			<forward name="initEliminarSra" path=".eliminarSra" />
			<forward name="initCambiarEstadoSra"
				path=".cambiarEstadoSra" />
			<forward name="mostrarEstablecimientos"
				path="/pages/altaEdicion/mostrarEstablecimientos.jsp" />
			<forward name="mostrarEstancias"
				path="/pages/altaEdicion/mostrarEstancias.jsp" />
			<forward name="errorMail" path=".errorPropietarioPage"
				redirect="false" />
			<forward name="mostrarId" path=".mostrarIdPage"
				redirect="true" />

		</action>


		<action path="/editarEstanciaValidate" parameter="method"
			type="ar.org.sicel.web.altaEdicion.actions.EdicionEstanciaAction"
			name="estanciaForm" validate="true">
			<forward name="failure"
				path="/listarEstancias.do?method=init" redirect="false" />
			<forward name="list" path="/listarEstancias.do?method=init"
				redirect="true" />
			<forward name="success" path=".edicionEstanciaPage"
				redirect="true" />
			<forward name="mostrarId" path=".mostrarIdPage"
				redirect="true" />

		</action>

		<action path="/listarEntidadRegional"
			type="ar.org.sicel.web.find.ListarEntidadRegionalAction"
			name="entidadRegionalForm" validate="false" parameter="method">
			<forward name="list" path=".listaEntidadRegionalPage" />
		</action>

		<action path="/editarEntidadRegionalValidate" parameter="method"
			type="ar.org.sicel.web.altaEdicion.actions.EdicionEntidadRegionalAction"
			name="entidadRegionalForm" validate="true" scope="session"
			input=".edicionEntidadRegionalPage">
			<forward name="failure"
				path="/listarEntidadRegional.do?method=listar" redirect="false" />
			<forward name="list"
				path="/listarEntidadRegional.do?method=listar" redirect="true" />
			<forward name="success" path=".edicionEntidadRegionalPage"
				redirect="false" />
			<forward name="initAddUbicacion"
				path="/edicionUbicacion.do?method=initAddUbicacion" />
			<forward name="mostrarId" path=".mostrarIdPage"
				redirect="true" />
		</action>


		<action path="/editarEcloValidate" parameter="method"
			type="ar.org.sicel.web.altaEdicion.actions.EdicionEcloAction"
			name="ecloForm" validate="true" scope="session"
			input=".edicionEcloPage">
			<forward name="success" path=".edicionEcloPage"
				redirect="false" />
			<forward name="list" path="/listarEclos.do?method=listar"
				redirect="true" />
			<forward name="failure" path="/listarEclos.do?method=listar"
				redirect="false" />
			<forward name="initAddUbicacion"
				path="/edicionUbicacion.do?method=initAddUbicacion" />
			<forward name="mostrarId" path=".mostrarIdPage"
				redirect="true" />
		</action>


		<action path="/edicionUbicacion" parameter="method"
			type="ar.org.sicel.web.altaEdicion.actions.EdicionUbicacionAction"
			name="ubicacionForm" validate="true" scope="request"
			input=".edicionUbicacionPage">
			<forward name="listarUbicaciones" path=".listaUbicacionPage"
				redirect="true" />
			<forward name="initAdd" path=".edicionUbicacionPage" />
			<forward name="success"
				path="/edicionUbicacion.do?method=listarUbicaciones" />
		</action>






		<action path="/bajaUbicacion"
			type="ar.org.sicel.web.bajas.BajaUbicacionAction"
			name="ubicacionForm" scope="request" input=".datosModificarUbicacion"
			unknown="false" validate="true">
