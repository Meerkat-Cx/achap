<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="ReporteTamboCriaInscriptas"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="842"
		 pageHeight="595"
		 columnWidth="842"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="AllSectionsNoDetail"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="IMG_ACHA" isForPrompting="false" class="java.lang.String"/>
	<parameter name="DIA_DE_HOY" isForPrompting="false" class="java.lang.String"/>
	<parameter name="FECHA_DESDE" isForPrompting="true" class="java.lang.String"/>
	<parameter name="FECHA_HASTA" isForPrompting="true" class="java.lang.String"/>
	<parameter name="FECHA_DESDE_P" isForPrompting="false" class="java.lang.String"/>
	<parameter name="FECHA_HASTA_P" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select t.eclo as ID_ECLO,t.id as ID_TAMBO, ct.nombre as NOMBRE_TAMBO, t.estancia as ID_ESTAB, ce.nombre as NOMBRE_ESTAB, t.propietario as ID_PROP, cp.nombre as NOMBRE_PROP, Hembras as HEMBRAS, Machos as MACHOS from  
(select tambo ,sum(hembras) Hembras, sum(Machos) Machos from 
(select tambo, count(*) hembras, 0 as machos from (select a.estab as tambo, a.id
                            from an_animal a join an_ficha_animal_pendiente fich on a.id = fich.ANIMAL_ID join pr_establecimiento pe on pe.LOTE = fich.LOTE_ID join en_establecimiento tambo on tambo.id = pe.ESTABLECIMIENTO
                            where a.esHembra=1
                            and a.estab=tambo.id
                            and (select min(af.fecha) from AN_FICHA_ANIMAL_PENDIENTE af where af.ANIMAL_ID = a.id )between to_date($P{FECHA_DESDE},'yyyy/mm/dd') and to_date($P{FECHA_HASTA},'yyyy/mm/dd')
                            and tambo.METODOCONTROL = 'CRIA') 
group by tambo
union
select tambo, 0 as hembras, count(*) machos from (select a.estab as tambo, a.id
                            from an_animal a join an_ficha_animal_pendiente fich on a.id = fich.ANIMAL_ID join pr_establecimiento pe on pe.LOTE = fich.LOTE_ID join en_establecimiento tambo on tambo.id = pe.ESTABLECIMIENTO
                            where a.esHembra=0
                            and a.estab=tambo.id
                            and (select min(af.fecha) from AN_FICHA_ANIMAL_PENDIENTE af where af.ANIMAL_ID = a.id )between to_date($P{FECHA_DESDE},'yyyy/mm/dd') and to_date($P{FECHA_HASTA},'yyyy/mm/dd')
                            and tambo.METODOCONTROL = 'CRIA') 
group by tambo) group by tambo) join en_establecimiento t on tambo=t.id join en_contacto ct on ct.id=t.id
join en_contacto ce on ce.id=t.estancia join en_contacto cp on cp.id=t.propietario
order by 1,6]]></queryString>

	<field name="NOMBRE_TAMBO" class="java.lang.String"/>
	<field name="ID_ECLO" class="java.lang.Long"/>
	<field name="ID_TAMBO" class="java.lang.Long"/>
