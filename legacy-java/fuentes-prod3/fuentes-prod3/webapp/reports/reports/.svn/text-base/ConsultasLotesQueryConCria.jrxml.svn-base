<?xml version="1.0" encoding="UTF-8"  ?>
<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="ConsultasLotesQueryConCria"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="842"
		 pageHeight="595"
		 columnWidth="842"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="FECHA_DESDE" isForPrompting="false" class="java.lang.String"/>
	<parameter name="FECHA_HASTA" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select usa.username,ecl.id as id_eclo,ecl.REGIONAL as regional,
     (select count(*) as cargados 
     from sicel.PR_PROCES p
                        where p.ID_USUARIO = usa.ID
         and p.fechaentrada >= to_date($P{FECHA_DESDE},'yyyy/mm/dd')
         and p.fechaentrada <= to_date($P{FECHA_HASTA},'yyyy/mm/dd')+1
                            and p.estado <> 'processError') lotesCargados,
    (select count(*)as lotesSinProcesados 
    from sicel.PR_PROCES p
    where p.ID_USUARIO = usa.ID
          and p.estado = 'uploaded'
         and p.fechaentrada >= to_date($P{FECHA_DESDE},'yyyy/mm/dd')
         and p.fechaentrada <= to_date($P{FECHA_HASTA},'yyyy/mm/dd')+1
    ) lotesSinProcesar,
    (select count(*)as lotesProcesados 
    from sicel.PR_PROCES p
    where p.ID_USUARIO = usa.ID
         and p.fecha >= to_date($P{FECHA_DESDE},'yyyy/mm/dd')
         and p.fecha <= to_date($P{FECHA_HASTA},'yyyy/mm/dd')+1
          and (p.estado = 'processed' or p.estado = 'downloaded')
    ) lotesProcesados,
    (select max(p.fechaentrada) as ultimoLoteCargado
    from sicel.PR_PROCES p
    where usa.ID= p.ID_USUARIO
        and p.fechasalida >= to_date($P{FECHA_DESDE},'yyyy/mm/dd')
         and p.fechasalida <= to_date($P{FECHA_HASTA},'yyyy/mm/dd')+1
    ) ultimoLoteCargado,
    (select max(p.fechasalida) as ultimoLoteProcesado
    from sicel.PR_PROCES p
    where usa.ID= p.ID_USUARIO
        and (p.estado = 'processed' or p.estado = 'downloaded')
        and p.fechasalida >= to_date($P{FECHA_DESDE},'yyyy/mm/dd')
        and p.fechasalida <= to_date($P{FECHA_HASTA},'yyyy/mm/dd')+1
    ) ultimoLoteProcesado,
    (
     select   /*+ INDEX(e idx_evento_fecha)*/  max(an.fnac) as ultimoInscriptosAlta from sicel.ev_evento e
    join sicel.en_establecimiento est on e.ESTABLECIMIENTO =est.id
    join sicel.ev_alta ea on ea.id = e.id
    join sicel.an_animal an on an.id = ea.animal
    where ea.ANIMAL >5946202
           and AN.FNAC >= to_date($P{FECHA_DESDE},'yyyy/mm/dd')
          and an.fnac <= to_date($P{FECHA_HASTA},'yyyy/mm/dd')+1
          and est.eclo = ecl.id ) ultimoInscriptoAlta,
    (select /*+ INDEX(e idx_evento_fecha)*/  max(e.fecha) as ultimoInscriptosParto from sicel.ev_evento e
        join sicel.en_establecimiento est on e.ESTABLECIMIENTO =est.id
        join sicel.ev_reproduccion er on er.id = e.id
        join sicel.ev_cria ec on ec.EVT_REPRODUCCION = er.id
        where ec.CRIA >5946202
            and er.ASOCIASICEL1 = 0
           and e.fecha >= to_date($P{FECHA_DESDE},'yyyy/mm/dd')
          and e.fecha <= to_date($P{FECHA_HASTA},'yyyy/mm/dd')+1
            and est.eclo = ecl.id)ultimoInscriptoParto
from sicel.SG_USUARIO usa
    join sicel.en_contacto con on usa.CONTACTO=con.id
    join sicel.en_eclo ecl on ecl.id = con.id
where usa.USERNAME like 'eclo%'
order by usa.username]]></queryString>

