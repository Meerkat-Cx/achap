<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="subreporteDatosEstablecimientosPropietario"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="489"
		 pageHeight="802"
		 columnWidth="489"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="PROPIETARIO_ID" isForPrompting="false" class="java.lang.Long"/>
	<parameter name="ID_ECLO" isForPrompting="false" class="java.lang.Integer"/>
	<parameter name="DIR_REPORTES" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select distinct e.ID as id_estan,c.NOMBRE as nombre_estan,e.ACTIVO as estado
from en_estancia e,en_establecimiento estab,en_propietario p,en_contacto c
where p.ID = $P{PROPIETARIO_ID} and p.ID = estab.PROPIETARIO and estab.ECLO = $P{ID_ECLO} and estab.ESTANCIA = e.ID and e.ID = c.ID
order by e.ID]]></queryString>

	<field name="id_estan" class="java.lang.Integer"/>
	<field name="nombre_estan" class="java.lang.String"/>
	<field name="estado" class="java.lang.Integer"/>

