<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="ConsultasLotesQueryPDF"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="595"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="IMG_ACHA" isForPrompting="false" class="java.lang.String"/>
	<parameter name="DIA_DE_HOY" isForPrompting="false" class="java.lang.String"/>
	<parameter name="FECHA_DESDE" isForPrompting="true" class="java.lang.String"/>
	<parameter name="FECHA_HASTA" isForPrompting="true" class="java.lang.String"/>
	<parameter name="FECHA_DESDE_P" isForPrompting="false" class="java.lang.String"/>
	<parameter name="FECHA_HASTA_P" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select usa.username,ecl.id as id_eclo,ecl.REGIONAL as regional,
     (select count(*) as cargados from PR_PROCES p
                        where p.ID_USUARIO = usa.ID
                            and to_char(p.FECHAENTRADA,'yyyy/mm/dd') >= $P{FECHA_DESDE}
                            and to_char(p.FECHAENTRADA,'yyyy/mm/dd') <= $P{FECHA_HASTA}
                            and p.estado <> 'processError') lotesCargados,
    (select count(*)as lotesSinProcesados from PR_PROCES p
    where p.ID_USUARIO = usa.ID
          and p.estado = 'uploaded'
          and to_char(p.FECHAENTRADA,'yyyy/mm/dd') >= $P{FECHA_DESDE}
          and to_char(p.FECHAENTRADA,'yyyy/mm/dd') <= $P{FECHA_HASTA}
    ) lotesSinProcesar,
    (select count(*)as lotesProcesados from PR_PROCES p
    where p.ID_USUARIO = usa.ID
           and to_char(p.FECHA,'yyyy/mm/dd') >= $P{FECHA_DESDE}
          and to_char(p.FECHA,'yyyy/mm/dd') <= $P{FECHA_HASTA}     
          and (p.estado = 'processed' or p.estado = 'downloaded')           
    ) lotesProcesados,
    (select max(p.fechaentrada) as ultimoLoteCargado
    from PR_PROCES p
    where usa.ID= p.ID_USUARIO
          and to_char(p.fechaentrada,'yyyy/mm/dd') >= $P{FECHA_DESDE}
          and to_char(p.fechaentrada,'yyyy/mm/dd') <= $P{FECHA_HASTA}     
        
    ) ultimoLoteCargado,
    (select   max(p.fechasalida) as ultimoLoteProcesado
    from PR_PROCES p
    where usa.ID= p.ID_USUARIO  
        and  (p.estado = 'processed' or p.estado = 'downloaded')
        and to_char(p.fechasalida,'yyyy/mm/dd') >= $P{FECHA_DESDE}
          and to_char(p.fechasalida,'yyyy/mm/dd') <= $P{FECHA_HASTA}  
    
    ) ultimoLoteProcesado
    
from SG_USUARIO usa 
    join en_contacto con on usa.CONTACTO=con.id
    join en_eclo ecl on ecl.id = con.id

where usa.USERNAME like 'eclo%'
order by usa.username]]></queryString>

