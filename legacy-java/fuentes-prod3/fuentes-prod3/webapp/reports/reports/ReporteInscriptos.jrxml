<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="ReporteInscriptos"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="595"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoDataSection"
		 isTitleNewPage="false"
		 isSummaryNewPage="false"
		 whenResourceMissingType="Empty">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="IMG_ACHA" isForPrompting="false" class="java.lang.String"/>
	<parameter name="FECHA_DESDE" isForPrompting="true" class="java.lang.String"/>
	<parameter name="FECHA_HASTA" isForPrompting="true" class="java.lang.String"/>
	<parameter name="FECHA_DESDE_T" isForPrompting="false" class="java.lang.String"/>
	<parameter name="FECHA_HASTA_T" isForPrompting="false" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[".\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="DIA_DE_HOY" isForPrompting="true" class="java.lang.String"/>
	<queryString><![CDATA[select distinct RAZA,ra.ID_RAZA_FIC, case when sum(PB)!= 0 then sum(PB) else 0 end PB,case when sum(RC)!= 0 then sum(RC) else 0 end RC, case when sum(AR)!= 0 then sum(AR) else 0 end AR, case when sum(CR)!= 0 then sum(CR) else 0 end CR, case when sum(MC)!= 0 then sum(MC) else 0 end MC, sum(CANTIDAD) CANTIDAD
                                        from   (select ra.NOMBRE RAZA, 'ALTA' EVENTO,CASE WHEN CATEGORIA='PB' then count(*)end PB,CASE WHEN CATEGORIA='RC' then count(*)end RC,CASE WHEN CATEGORIA like '%AR' then count(*)end AR,CASE WHEN CATEGORIA='CR' then count(*)end CR, CASE WHEN CATEGORIA='MC' then count(*)end MC, count(*) CANTIDAD from an_animal a, EV_ALTA ea,pr_ev_estab pee,pr_establecimiento pe,pr_lote pl,pr_proces pp, AN_RAZA ra
                                                where a.id > 5946202  and a.categoria !='PED' and ea.ANIMAL=a.id and pee.EV_ESTAB = ea.id 
                                                and razadeclara = ra.id and pee.pr_estab = pe.id  and pe.LOTE = pl.id  and pp.PR_LOTE = pl.ID
                                                                       and pp.FECHAENTRADA >= to_date($P{FECHA_DESDE},'yyyy/mm/dd')
                                                                       and pp.FECHAENTRADA <= to_date($P{FECHA_HASTA},'yyyy/mm/dd')
                                                                        GROUP BY(ra.NOMBRE, categoria)
                                                UNION
                                                select ra.NOMBRE RAZA, 'REPRODUCCION' EVENTO,CASE WHEN CATEGORIA='PB' then count(*)end PB,CASE WHEN CATEGORIA='RC' then count(*)end RC,CASE WHEN CATEGORIA like '%AR' then count(*)end AR,CASE WHEN CATEGORIA='CR' then count(*)end CR, CASE WHEN CATEGORIA='MC' then count(*)end MC, count(*) CANTIDAD  from an_animal a, EV_cria ec, ev_reproduccion er, pr_ev_animal pea, pr_animal pa, pr_establecimiento pe, pr_lote pl, pr_proces pp, AN_RAZA ra
                                                where a.id > 5946202 and a.categoria !='PED' and ec.cria=a.id  and not exists (select * from ev_alta where animal = a.id)
                                                and razadeclara = ra.id and ec.EVT_REPRODUCCION = er.id and er.id = pea.EV_ANIM  and pea.PR_ANIMAL= pa.ID  and pa.PR_ESTAB=pe.ID
                                                      and pe.LOTE = pl.id and pp.PR_LOTE = pl.ID  
                                                      and pp.FECHAENTRADA >= to_date($P{FECHA_DESDE},'yyyy/mm/dd')
                                                      and pp.FECHAENTRADA <= to_date($P{FECHA_HASTA},'yyyy/mm/dd')
                                                      GROUP BY(ra.NOMBRE, categoria)) tabla, AN_RAZA ra
                          WHERE RAZA = ra.NOMBRE
group by(RAZA,ra.ID_RAZA_FIC)
order by(ra.ID_RAZA_FIC)]]></queryString>

	<field name="RAZA" class="java.lang.String"/>
	<field name="CANTIDAD" class="java.lang.Long"/>
	<field name="RC" class="java.lang.Long"/>
	<field name="AR" class="java.lang.Long"/>
	<field name="MC" class="java.lang.Long"/>
	<field name="CR" class="java.lang.Long"/>
	<field name="PB" class="java.lang.Long"/>

	<variable name="TOTAL" class="java.lang.Long" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{CANTIDAD}]]></variableExpression>
	</variable>
