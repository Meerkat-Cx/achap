	<queryString><![CDATA[select distinct e.ID as id_eclo,c.NOMBRE as nombre_eclo,e.ACTIVO as estado
from en_eclo e,en_establecimiento estab,en_propietario p,en_contacto c
where p.ID = $P{PROPIETARIO_ID} and p.ID = estab.PROPIETARIO and estab.ECLO = e.ID and e.ID = c.ID
order by e.ID]]></queryString>

