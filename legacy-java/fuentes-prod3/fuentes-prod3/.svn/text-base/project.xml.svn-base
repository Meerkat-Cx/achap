        <!--<dependency>
            <groupId>jboss</groupId>
            <artifactId>jbossall-client</artifactId>
            <version>4.0.2</version>
            <type>jar</type>
        </dependency>-->
        <dependency>
            <groupId>dom4j</groupId>
            <artifactId>dom4j</artifactId>
            <version>1.4</version>
            <type>jar</type>
        </dependency>
        <dependency>
            <groupId>joda-time</groupId>
            <artifactId>joda-time</artifactId>
            <version>1.0</version>
            <type>jar</type>
        </dependency>
        
         <dependency>
            <groupId>velocity</groupId>
            <artifactId>velocity</artifactId>
            <version>1.4-dev</version>
            <type>jar</type>
        </dependency>
        
         <dependency>
            <groupId>log4j</groupId>
            <artifactId>log4j</artifactId>
            <version>1.2.8</version>
            <type>jar</type>
        </dependency>
        <!--For Sicel Reports -->   
        <dependency>
            <groupId>sicel3</groupId>
            <artifactId>lotes</artifactId>
            <version>${pom.currentVersion}</version>
            <type>jar</type>
            <properties>
                <jar.bundle>true</jar.bundle>
            </properties>
        </dependency>
        <dependency>
            <groupId>sicel3</groupId>
            <artifactId>util</artifactId>
            <version>${pom.currentVersion}</version>
            <type>jar</type>
            <properties>
                <jar.bundle>true</jar.bundle>
            </properties>
        </dependency>
        <dependency>
            <groupId>sicel3</groupId>
            <artifactId>persistence</artifactId>
            <version>${pom.currentVersion}</version>
            <type>jar</type>
            <properties>
		        <ear.bundle>true</ear.bundle>
		        <ear.bundle.name>persistence-${pom.currentVersion}.har</ear.bundle.name>
     		</properties>
        </dependency>
        
        <!--<dependency>
            <groupId>sicel3</groupId>
            <artifactId>process</artifactId>
            <version>${pom.currentVersion}</version>
            <type>ejb</type>
            <properties>
		        <ear.bundle>true</ear.bundle>
		    </properties>
        </dependency>-->
        <dependency>
            <groupId>sicel3</groupId>
            <artifactId>web</artifactId>
            <version>${pom.currentVersion}</version>
            <type>war</type>
            <properties>
		        <ear.bundle>true</ear.bundle>
      		</properties>
        </dependency>
			<!-- este es para generar los reportes desde la base -->
         <dependency>
            <groupId>sicel3</groupId>
            <artifactId>webdocs</artifactId>
            <version>${pom.currentVersion}</version>
            <type>jar</type>
        </dependency>
	</dependencies>   
	<build>    
	<resources>
	
                <resource>
                    <directory>common/resources/log4j</directory>
                    <includes>
                        <include>**/*</include>
                    </includes>
                  </resource>
    
            </resources>        
	</build>            
</project>

