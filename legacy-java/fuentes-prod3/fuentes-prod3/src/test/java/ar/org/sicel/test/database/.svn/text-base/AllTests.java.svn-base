package ar.org.sicel.test.database;

import junit.framework.Test;
import junit.framework.TestSuite;

/**
 * @author pablo
 */
public class AllTests {

	public static Test suite() {
		TestSuite suite = new TestSuite("Test for ar.org.sicel.persistence");
		//$JUnit-BEGIN$
		suite.addTestSuite(TestEstablecimiento.class);
		suite.addTestSuite(TestAtributoEstablecimiento.class);
		suite.addTestSuite(TestEclo.class);
		suite.addTestSuite(TestPropietario.class);
		//$JUnit-END$
		return suite;
	}
}
