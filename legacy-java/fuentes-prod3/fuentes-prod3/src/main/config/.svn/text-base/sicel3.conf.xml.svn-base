	<procesamiento>

	<!-- <destinoDir>C:/sicel3/proc/</destinoDir>
        <dirReportes>C:/sicel3/proc/reports/</dirReportes>
		<xsltDir>C:/sicel3/proc/xslt/</xsltDir>
