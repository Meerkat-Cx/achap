paging.banner.item_name=item
paging.banner.items_name=items

paging.banner.no_items_found=<span class="pagelinks">Ningún {0} encontrado.</span>
paging.banner.one_item_found=<span class="pagelinks">Un {0} encontrado.</span>
paging.banner.all_items_found=<span class="pagelinks">{0} {1} encontrados, mostrando los {2}.</span>
paging.banner.some_items_found=<span class="pagelinks">{0} {1} encontrados, mostrando del {2} al {3}.</span>

paging.banner.full=<span class="pagelinks">[<a href="{1}">Primero</a>/<a href="{2}">Anterior</a>] {0} [<a href="{3}">Siguiente</a>/<a href="{4}">Último</a>]</span>
paging.banner.first=<span class="pagelinks">[Primero/Anterior] {0} [<a href="{3}">Siguiente</a>/<a href="{4}">Último</a>]</span>
paging.banner.last=<span class="pagelinks">[<a href="{1}">Primero</a>/<a href="{2}">Anterior</a>] {0} [Siguiente/Último]</span>
