package ar.org.sicel.web.proc;

import org.apache.struts.action.ActionForm;

/**
 * @author jdivars
 *
 */
public class IntercambioForm extends ActionForm {

	
	private static final long serialVersionUID = 1L;
	Long idProp1 =null;
	Long idProp2 =null;
	String nombreProp1 = "";
	String nombreProp2 = "";
	public void reset() {
		this.setIdProp1(null);
		this.setIdProp2(null);
		this.setNombreProp1("");
		this.setNombreProp2("");
		
	}
	public Long getIdProp1() {
		return idProp1;
	}
	public void setIdProp1(Long idProp1) {
		this.idProp1 = idProp1;
	}
	public Long getIdProp2() {
		return idProp2;
	}
	public void setIdProp2(Long idProp2) {
		this.idProp2 = idProp2;
	}
	public String getNombreProp1() {
		return nombreProp1;
	}
	public void setNombreProp1(String nombreProp1) {
		this.nombreProp1 = nombreProp1;
	}
	public String getNombreProp2() {
		return nombreProp2;
	}
	public void setNombreProp2(String nombreProp2) {
		this.nombreProp2 = nombreProp2;
	}

}
