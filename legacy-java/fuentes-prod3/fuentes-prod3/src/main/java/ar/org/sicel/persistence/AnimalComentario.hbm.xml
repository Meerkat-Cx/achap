<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping
>
    <class name="ar.org.sicel.persistence.AnimalComentario" table="an_Animal_Comentario" lazy="true">

        <id
            name="id"
            column="id"
            type="java.lang.Long">
			
			<generator class="native">
                <param name="sequence">GEN_ANIMAL_COMENTARIO</param>
            </generator> 


        </id>


        <property
            name="fecha"
            type="java.util.Date"
            update="true"
            insert="true"
        />
         
		<property name="comentario" type="java.lang.String" update="true" insert="true" not-null="true" length="500"/>
	 
		<many-to-one
            name="usuario"
            class="ar.org.sicel.persistence.Usuario"
            cascade="none"
            outer-join="auto"
            update="true"
            insert="true"
            foreign-key="FK_USUARIO_ANIM_COMENT"
            not-null="true"
        />

        <many-to-one
            name="animal"
            class="ar.org.sicel.persistence.Animal"
            cascade="none"
            outer-join="auto"
            update="true"
            insert="true"
            foreign-key="FK_ANIMAL_COMENT"
            not-null="true"
        />
        
    </class>

</hibernate-mapping>
