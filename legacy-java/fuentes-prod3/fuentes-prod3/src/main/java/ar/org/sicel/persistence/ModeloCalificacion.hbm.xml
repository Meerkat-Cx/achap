<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping
>
    <class
        name="ar.org.sicel.persistence.ModeloCalificacion"
        table="Ca_Mdl"
        lazy="true"
    >

        <id
            name="id"
            column="id"
            type="java.lang.Long"
        >
            <generator class="native">
                <param name="sequence">gen_ca_mdl</param>
              <!--  
                  To add non XDoclet generator parameters, create a file named 
                  hibernate-generator-params-ModeloCalificacion.xml 
                  containing the additional parameters and place it in your merge dir. 
              --> 
            </generator>
        </id>

        <property
            name="fecha"
            type="java.util.Date"
            update="true"
            insert="true"
        >
            <column
                name="fecha" 
                not-null="true"
            />
        </property>

        <property
            name="esHembra"
            type="java.lang.Boolean"
            update="true"
            insert="true"
        >
            <column
                name="esHembra" 
                not-null="true"
            />
        </property>

        <many-to-one
            name="raza"
            class="ar.org.sicel.persistence.Raza"
            cascade="none"
            outer-join="auto"
            update="true"
            insert="true"
            foreign-key="FK_Ca_Mdl_Raza"
            column="raza"
            not-null="true"
        />

        <set
            name="parteCalificacions"
            lazy="true"
            inverse="true"
            cascade="delete"
            sort="unsorted"
        >

            <key
                column="modelo"
            >
            </key>

            <one-to-many
                  class="ar.org.sicel.persistence.ParteCalificacion"
            />

        </set>

        <!--
            To add non XDoclet property mappings, create a file named
                hibernate-properties-ModeloCalificacion.xml
            containing the additional properties and place it in your merge dir.
        -->

    </class>

</hibernate-mapping>
