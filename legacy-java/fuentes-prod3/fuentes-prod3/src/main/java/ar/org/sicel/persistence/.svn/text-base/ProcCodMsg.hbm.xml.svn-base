<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping
>
    <class
        name="ar.org.sicel.persistence.ProcCodMsg"
        table="Pr_CodMsg"
        lazy="true"
    >

        <id
            name="id"
            type="java.lang.String"
        >
                <column
                    name="id" 
                    length="8"
                    not-null="true"
                />
            <generator class="assigned">
              <!--  
                  To add non XDoclet generator parameters, create a file named 
                  hibernate-generator-params-ProcCodMsg.xml 
                  containing the additional parameters and place it in your merge dir. 
              --> 
            </generator>
        </id>

        <property
            name="descripcion"
            type="java.lang.String"
            update="true"
            insert="true"
        >
            <column
                name="descripcion" 
                not-null="true"
            />
        </property>

        <property
            name="comentario"
            type="java.lang.String"
            update="true"
            insert="true"
            column="comentarios"
        />

        <property
            name="formato"
            type="java.lang.String"
            update="true"
            insert="true"
            column="FORMATOMSG"
            not-null="false"
        />

        <set
            name="procMsgsses"
            lazy="true"
            inverse="true"
            cascade="none"
            sort="unsorted"
        >

            <key
                column="codigoMensaje"
            >
            </key>

            <one-to-many
                  class="ar.org.sicel.persistence.ProcMsg"
            />

        </set>

        <!--
            To add non XDoclet property mappings, create a file named
                hibernate-properties-ProcCodMsg.xml
            containing the additional properties and place it in your merge dir.
        -->

    </class>

</hibernate-mapping>
