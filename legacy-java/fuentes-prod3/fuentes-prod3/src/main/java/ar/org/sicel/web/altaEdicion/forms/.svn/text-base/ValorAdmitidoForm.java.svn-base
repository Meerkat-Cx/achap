package ar.org.sicel.web.altaEdicion.forms;

import org.apache.struts.validator.ValidatorActionForm;

import ar.org.sicel.persistence.ValorAdmAtr;
import ar.org.sicel.persistence.ValorAdmAtrDAO;

/**
 * @author Ramiro Trachsel
 *
 */
/**
*
* struts.form
*      name="valorAdmitidoForm"
*
*/
public class ValorAdmitidoForm extends ValidatorActionForm {

	/**
	 * 
	 */
	private static final long serialVersionUID = 9046537510180057790L;
	ValorAdmAtr valorAdmitido = ValorAdmAtrDAO.create("");
	Long id = new Long(-1);
	
	public ValorAdmitidoForm() {
		// TODO Auto-generated constructor stub
	}

	public Long getId() {
		return id;
	}

	public void setId(Long id) {
		this.id = id;
	}

	public ValorAdmAtr getValorAdmitido() {
		return valorAdmitido;
	}

	public void setValorAdmitido(ValorAdmAtr valorAdmitido) {
		this.valorAdmitido = valorAdmitido;
	}
	
}
