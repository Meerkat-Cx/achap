 */
package ar.org.sicel.web.find;



import java.util.ArrayList;
import java.util.List;

import org.apache.struts.action.ActionForm;

/**
 * @author jdivars
 * Form que se utiliza para la generacion de reporte de eventos
 */
public class ReporteEventosForm extends ActionForm {

	/**
	 * 
	 */
	private static final long serialVersionUID = 1L;
	
	 
	private String idEclos;
	private String idEst="";
	private String idEclo;
	private String nombreEstablecimiento;
	private String fechaInic;
	private String fechaFin;
	private String nombreEclo;
	private String idEclosSession="";
	private List listaEclos;
	
	public void reset(){
		this.setIdEclos("");
		this.setIdEst("");
		this.setIdEclo("");
		this.setNombreEstablecimiento("");
		this.setFechaInic("");
		this.setFechaFin("");
		this.setNombreEclo("");
		this.listaEclos = new ArrayList();
	}
	public String getNombreEclo() {
		return nombreEclo;
	}
	public void setNombreEclo(String nombreEclo) {
		this.nombreEclo = nombreEclo;
	}
	public String getFechaFin() {
		return fechaFin;
	}
	public void setFechaFin(String fechaFin) {
		this.fechaFin = fechaFin;
	}
	public String getFechaInic() {
		return fechaInic;
	}
	public void setFechaInic(String fechaInic) {
		this.fechaInic = fechaInic;
	}
	
	
	
	
	public String getIdEclos() {
		return idEclos;
	}
	public void setIdEclos(String idEclos) {
		this.idEclos = idEclos;
	}
	public String getIdEst() {
		return idEst;
	}
	public void setIdEst(String idEst) {
		this.idEst = idEst;
	}
	public String getNombreEstablecimiento() {
		return nombreEstablecimiento;
	}
	public void setNombreEstablecimiento(String nombreEstablecimiento) {
		this.nombreEstablecimiento = nombreEstablecimiento;
	}
	public String getIdEclo() {
		return idEclo;
	}
	public void setIdEclo(String idEclo) {
		this.idEclo = idEclo;
	}
	public String getIdEclosSession() {
		return idEclosSession;
	}
	public void setIdEclosSession(String idEclosSession) {
		this.idEclosSession = idEclosSession;
	}
	public List getListaEclos() {
		return listaEclos;
	}
	public void setListaEclos(List listaEclos) {
		this.listaEclos = listaEclos;
	}
	

	
}
