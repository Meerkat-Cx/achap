<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping
>
    <class
        name="ar.org.sicel.persistence.FichaAnimalPendiente"
        table="An_Ficha_Animal_Pendiente"
        lazy="false">

        <id
            name="id"
            column="id"
            type="java.lang.Long">
<!--
			<generator class="foreign">
				<param name="property">animal</param>
			</generator>
-->					
			<generator class="native">
                <param name="sequence">GEN_AN_FICHA_PENDIENTE</param>
            </generator> 


        </id>


        <property
            name="fecha"
            type="java.util.Date"
            update="true"
            insert="true"
        >
            <column
                name="FECHA" 
            />
        </property>

        <property
            name="pendiente"
            type="java.lang.Boolean"
            update="true"
            insert="true"
        >
            <column
                name="PENDIENTE" 
            />
        </property>
<!--
        <one-to-one
            name="animal"
            class="ar.org.sicel.persistence.Animal"
            constrained="true"
        />
-->        
   <!--      <property
            name="loteId"
            type="java.lang.Long"
            update="true"
            insert="true"
        >
            <column
                name="NUMERO_LOTE" 
                not-null="true"
            />
        </property>
        -->
     <!--    <property
            name="ecloId"
            type="java.lang.Long"
            update="true"
            insert="true"
        >
            <column
                name="ECLO_ID"
                not-null="true" 
            />
        </property>-->

	  	 <many-to-one
            name="animal"
            class="ar.org.sicel.persistence.Animal"
            cascade="none"
            outer-join="auto"
            update="true"
            insert="true"
            foreign-key="FK_AN_FICHA_ANIMAL_PENDIENTE"
            column="animal_id"
            not-null="true"
        />
        <many-to-one
            name="procLote"
            class="ar.org.sicel.persistence.ProcLote"
            cascade="none"
            outer-join="auto"
            update="false"
            insert="false"
            foreign-key="FK_AN_FICHA_ANIMAL_PRLOTE"
            column="lote_id"
        />

    </class>

</hibernate-mapping>
