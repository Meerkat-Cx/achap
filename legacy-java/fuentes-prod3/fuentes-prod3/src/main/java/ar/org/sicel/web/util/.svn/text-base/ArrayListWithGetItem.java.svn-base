package ar.org.sicel.web.util;

import java.util.ArrayList;
import java.util.Collection;

public class ArrayListWithGetItem extends ArrayList {

    /**
	 * 
	 */
	private static final long serialVersionUID = 4845594666468781956L;

	@SuppressWarnings("unchecked")
	public ArrayListWithGetItem(Collection col) {
        super(col);
    }

    public Object getItem(int index) {
        return super.get(index);
    }

}
