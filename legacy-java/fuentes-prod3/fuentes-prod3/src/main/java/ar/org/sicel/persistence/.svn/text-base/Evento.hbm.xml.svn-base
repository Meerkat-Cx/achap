    <class
        name="ar.org.sicel.persistence.Evento"
        table="Ev_Evento"
        lazy="true"
    >

        <id
            name="id"
            column="id"
            type="java.lang.Long"
        >
            <generator class="native">
                <param name="sequence">gen_ev_evento</param>
              <!--  
                  To add non XDoclet generator parameters, create a file named 
                  hibernate-generator-params-Evento.xml 
                  containing the additional parameters and place it in your merge dir. 
              --> 
            </generator>
        </id>

        <property
            name="fecha"
            type="java.util.Date"
            update="true"
            insert="true"
        >
            <column
                name="fecha" 
                not-null="true"
            />
        </property>

        <many-to-one
            name="establecimiento"
            class="ar.org.sicel.persistence.Establecimiento"
            cascade="none"
            outer-join="auto"
            update="true"
            insert="true"
            foreign-key="FK_EvEstab_Estab"
            column="establecimiento"
            not-null="true"
        />

        <set
            name="dependientes"
            table="EV_DEPENDIENTES"
            lazy="true"
            cascade="none"
            sort="ar.org.sicel.persistence.EventosPorFechaYTipo"
        >

            <key
                column="idevento"
                foreign-key="FK_EV_DEPENDIENTE"
            >
            </key>

            <many-to-many
                class="ar.org.sicel.persistence.Evento"
                column="dependiente"
                outer-join="auto"
                foreign-key="FK_EV_DEPENDIENTE1"
             />

        </set>

        <set
            name="modificaciones"
            table="EV_MODIFICACIONES"
            lazy="true"
            cascade="none"
            sort="ar.org.sicel.persistence.EventosPorFechaYTipo"
        >

            <key
                column="idevento"
                foreign-key="FK_EV_MODIFICACIONES"
            >
            </key>
            
            <many-to-many
                class="ar.org.sicel.persistence.Evento"
                column="modificado"
                outer-join="auto" 
                foreign-key="FK_EV_MODIFICACIONES1"
             />

        </set>

        <!--
            To add non XDoclet property mappings, create a file named
                hibernate-properties-Evento.xml
            containing the additional properties and place it in your merge dir.
        -->

