<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping
>
    <class
        name="ar.org.sicel.persistence.Especie"
        table="An_Especie"
        lazy="true"
    >

        <id
            name="id"
            type="java.lang.String"
        >
                <column
                    name="id" 
                    length="4"
                />
            <generator class="assigned">
              <!--  
                  To add non XDoclet generator parameters, create a file named 
                  hibernate-generator-params-Especie.xml 
                  containing the additional parameters and place it in your merge dir. 
              --> 
            </generator>
        </id>

        <property
            name="nombre"
            type="java.lang.String"
            update="true"
            insert="true"
        >
            <column
                name="nombre" 
                length="60"
                not-null="true"
            />
        </property>

        <set
            name="razas"
            lazy="true"
            inverse="true"
            cascade="none"
            sort="unsorted"
        >

            <key
                column="especie"
            >
            </key>

            <one-to-many
                  class="ar.org.sicel.persistence.Raza"
            />

        </set>

        <many-to-one
            name="atrVariables"
            class="ar.org.sicel.persistence.AtrVariables"
            cascade="all"
            outer-join="auto"
            update="true"
            insert="true"
            foreign-key="FK_Espe_AtrVar"
            unique-key="UN_An_Espe_atr_Variables"
            not-null="false"
        >
        </many-to-one>

        <!--
            To add non XDoclet property mappings, create a file named
                hibernate-properties-Especie.xml
            containing the additional properties and place it in your merge dir.
        -->

    </class>

</hibernate-mapping>
