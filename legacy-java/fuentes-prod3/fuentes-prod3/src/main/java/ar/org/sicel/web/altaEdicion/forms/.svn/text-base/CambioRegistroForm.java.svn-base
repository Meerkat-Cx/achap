package ar.org.sicel.web.altaEdicion.forms;

import org.apache.struts.action.ActionForm;

/**
 * @author jdivars
 *
 */
public class CambioRegistroForm extends ActionForm {
	
	private static final long serialVersionUID = 1L;
	private String tipoR =null;
	private String numR = null;
	private String tipoNew =null;
	private String numNew = null;
	private Long id =null;
	public Long getId() {
		return id;
	}
	public void setId(Long id) {
		this.id = id;
	}
	public String getNumNew() {
		return numNew;
	}
	public void setNumNew(String numNew) {
		this.numNew = numNew;
	}
	public String getTipoNew() {
		return tipoNew;
	}
	public void setTipoNew(String tipoNew) {
		this.tipoNew = tipoNew;
	}
	public String getNumR() {
		return numR;
	}
	public void setNumR(String numR) {
		this.numR = numR;
	}
	public String getTipoR() {
		return tipoR;
	}
	public void setTipoR(String tipoR) {
		this.tipoR = tipoR;
	}

}
