<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping
>
    <class
        name="ar.org.sicel.persistence.ValorAdmAtr"
        table="At_Valor_Admitido"
        lazy="true"
    >

        <id
            name="id"
            column="id"
            type="java.lang.Long"
        >
            <generator class="native">
                <param name="sequence">gen_at_valor_admitido</param>
              <!--  
                  To add non XDoclet generator parameters, create a file named 
                  hibernate-generator-params-ValorAdmAtr.xml 
                  containing the additional parameters and place it in your merge dir. 
              --> 
            </generator>
        </id>

        <property
            name="valor"
            type="java.lang.String"
            update="true"
            insert="true"
        >
            <column
                name="valor" 
                length="20"
            />
        </property>

        <many-to-one
            name="atributo"
            class="ar.org.sicel.persistence.Atributo"
            cascade="none"
            outer-join="auto"
            update="true"
            insert="true"
            foreign-key="FK_Vaad_Atri"
            column="atributo"
            not-null="true"
        />

        <!--
            To add non XDoclet property mappings, create a file named
                hibernate-properties-ValorAdmAtr.xml
            containing the additional properties and place it in your merge dir.
        -->

    </class>

</hibernate-mapping>
