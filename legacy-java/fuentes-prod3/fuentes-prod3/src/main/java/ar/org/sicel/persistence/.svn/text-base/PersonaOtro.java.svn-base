package ar.org.sicel.persistence;



/**
 *
 * @hibernate.joined-subclass
 *    table="En_PerOtr"
 *     lazy="true"
 *
 * @hibernate.joined-subclass-key
 *    column="id"
 *    foreign-key="FK_PeOt_Pers"
 *
 */
public class PersonaOtro extends ar.org.sicel.persistence.Persona {
    // --------------- attributes ---------------------
    public PersonaOtro() {
    }
    
       
    public void setApellido(String apellido) {    	
    	super.setApellido(apellido);
    }
        
    public void setNombrePersona(String nombrePersona) {
       	super.setNombrePersona(nombrePersona);       	
    }
        
    public void setNombreContacto(String nombreContacto) {
       	super.setNombreContacto(nombreContacto);
    }

    public void setDocumento(Integer documento) {
       	super.setDocumento(documento);
    }
        
    public void setTipoDocumento(String tipoDocumento) {
    	super.setTipoDocumento(tipoDocumento);
    }
        
    public void setComentario(String comentario) {
    	super.setComentario(comentario);
    }
    
    
    
    // ------------- relations ------------------
    // ---------------- business methods  ----------------------
    
    
}
