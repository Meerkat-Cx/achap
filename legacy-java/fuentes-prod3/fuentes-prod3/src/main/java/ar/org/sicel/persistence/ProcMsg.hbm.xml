<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping
>
    <class
        name="ar.org.sicel.persistence.ProcMsg"
        table="Pr_Msg"
        lazy="true"
    >

        <id
            name="id"
            column="id"
            type="java.lang.Long"
        >
            <generator class="native">
                <param name="sequence">gen_pr_msgs</param>
              <!--  
                  To add non XDoclet generator parameters, create a file named 
                  hibernate-generator-params-ProcMsg.xml 
                  containing the additional parameters and place it in your merge dir. 
              --> 
            </generator>
        </id>

        <property
            name="nivelError"
            type="java.lang.Byte"
            update="true"
            insert="true"
        >
            <column
                name="nivelError" 
                not-null="true"
            />
        </property>

        <property
            name="informacion"
            type="java.lang.String"
            update="true"
            insert="true"
            column="informacion"
            length="4000"
        />

        <array
            name="valores"
            table="PR_MSG_VALOR"
            cascade="none"
        >

            <key
                column="MSG"
                  foreign-key="FK_Pr_Vals_prmsg"
            >
            </key>

            <index
                column="POS"
                type="integer"
            />

            <element
                column="VALOR"
                type="string"
                not-null="false"
                unique="false"
            />

        </array>

        <many-to-one
            name="codigoMsg"
            class="ar.org.sicel.persistence.ProcCodMsg"
            cascade="none"
            outer-join="auto"
            update="true"
            insert="true"
            foreign-key="FK_Pr_Msg_cmsg"
            column="codigoMensaje"
            not-null="true"
        />

        <!--
            To add non XDoclet property mappings, create a file named
                hibernate-properties-ProcMsg.xml
            containing the additional properties and place it in your merge dir.
        -->

    </class>

</hibernate-mapping>
