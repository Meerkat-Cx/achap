<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping
>
    <class
        name="ar.org.sicel.persistence.CentroDeComputo"
        table="En_Centro_De_Computo"
        lazy="true"
    >

        <id
            name="id"
            column="id"
            type="java.lang.Long"
        >
            <generator class="native">
                <param name="sequence">gen_centro_de_computo</param>
              <!--  
                  To add non XDoclet generator parameters, create a file named 
                  hibernate-generator-params-CentroDeComputo.xml 
                  containing the additional parameters and place it in your merge dir. 
              --> 
            </generator>
        </id>

        <property
            name="nombre"
            type="java.lang.String"
            update="true"
            insert="true"
        >
            <column
                name="nombre" 
                length="60"
            />
        </property>

        <property
            name="ciudad"
            type="java.lang.String"
            update="true"
            insert="true"
        >
            <column
                name="ciudad" 
                length="60"
                
            />
        </property>

        <property
            name="direccion"
            type="java.lang.String"
            update="true"
            insert="true"
        >
            <column
                name="direccion" 
                length="60"
            />
        </property>

        <property
            name="codigoPostal"
            type="java.lang.String"
            update="true"
            insert="true"
        >
            <column
                name="codigo_postal" 
                length="10"
            />
        </property>

        <property
            name="mail"
            type="java.lang.String"
            update="true"
            insert="true"
        >
            <column
                name="email" 
                length="40"
            />
        </property>

        <property
            name="telefono"
            type="java.lang.String"
            update="true"
            insert="true"
        >
            <column
                name="telefono" 
                length="80"
            />
        </property>
        
        <property
            name="activo"
            type="java.lang.Boolean"
            update="true"
            insert="true"
        >
            <column
                name="activo" 
            />
        </property>
        
        <set
            name="bitacora"
            lazy="true"
            inverse="true"
            cascade="all"
            sort="unsorted"
            order-by="fecha"
        >

            <key
                column="centro"
            >
            </key>

            <one-to-many
                  class="ar.org.sicel.persistence.LogContacto"
            />

        </set>
        
        <set
            	name="tambos"
            	lazy="true" inverse="true"
            	cascade="all"
            	order-by="id asc"
        	>
            	<key
                	column="centro" 
            	>
            	</key>
            	<one-to-many
                 	 class="ar.org.sicel.persistence.Establecimiento" 
            	/>
	        </set>

    </class>

</hibernate-mapping>
