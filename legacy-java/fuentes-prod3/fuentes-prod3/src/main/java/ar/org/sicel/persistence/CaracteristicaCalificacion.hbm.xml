<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping
>
    <class
        name="ar.org.sicel.persistence.CaracteristicaCalificacion"
        table="Ca_Mdl_Carac"
        lazy="true"
    >

        <id
            name="id"
            column="id"
            type="java.lang.Long"
        >
            <generator class="native">
                <param name="sequence">gen_ca_mdl_carac</param>
              <!--  
                  To add non XDoclet generator parameters, create a file named 
                  hibernate-generator-params-CaracteristicaCalificacion.xml 
                  containing the additional parameters and place it in your merge dir. 
              --> 
            </generator>
        </id>

        <property
            name="nombre"
            type="java.lang.String"
            update="true"
            insert="true"
        >
            <column
                name="nombre" 
                length="60"
                not-null="true"
            />
        </property>

        <many-to-one
            name="parteCalificacion"
            class="ar.org.sicel.persistence.ParteCalificacion"
            cascade="none"
            outer-join="auto"
            update="true"
            insert="true"
            foreign-key="FK_Ca_Mdl_Carac"
            column="parte"
            not-null="true"
        />

        <!--
            To add non XDoclet property mappings, create a file named
                hibernate-properties-CaracteristicaCalificacion.xml
            containing the additional properties and place it in your merge dir.
        -->

    </class>

</hibernate-mapping>
