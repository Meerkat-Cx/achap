<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping
>
    <class
        name="ar.org.sicel.persistence.AtrVariables"
        table="At_Atr_Variables"
        lazy="true"
    >

        <id
            name="id"
            column="id"
            type="java.lang.Long"
        >
            <generator class="native">
                <param name="sequence">gen_at_atr_variables</param>
              <!--  
                  To add non XDoclet generator parameters, create a file named 
                  hibernate-generator-params-AtrVariables.xml 
                  containing the additional parameters and place it in your merge dir. 
              --> 
            </generator>
        </id>

        <set
            name="valors"
            lazy="true"
            inverse="true"
            cascade="all"
            sort="unsorted"
        >

            <key
                column="atr_variable" 
                not-null="true"
            />

            <one-to-many
                  class="ar.org.sicel.persistence.Valor"
            />

        </set>

        <!--
            To add non XDoclet property mappings, create a file named
                hibernate-properties-AtrVariables.xml
            containing the additional properties and place it in your merge dir.
        -->

    </class>

</hibernate-mapping>
