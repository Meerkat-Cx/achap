            class="ar.org.sicel.persistence.Raza"
            cascade="none"
            outer-join="auto"
            update="true"
            insert="true"
            foreign-key="FK_Anim_Sinonimo_RazaDeclarada"
            column="razaDeclara"
            not-null="false"
        />
        
        <many-to-one
