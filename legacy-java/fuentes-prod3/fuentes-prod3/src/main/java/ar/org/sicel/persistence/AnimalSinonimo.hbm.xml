            update="true"
            insert="true"
            foreign-key="FK_Anim_Sinonimo_Estab_Criador"
            column="estab_Criador"
        />
        
        <many-to-one
            name="sinonimo"
            class="ar.org.sicel.persistence.Animal"
            cascade="none"
            outer-join="auto"
            update="true"
            insert="true"
            foreign-key="FK_Anim_Sinonimo_Animal"
            column="sinonimo"
        />
      
      
    </class>

</hibernate-mapping>
