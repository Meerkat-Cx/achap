<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping
>
    <class
        name="ar.org.sicel.persistence.AnimalSinonimo"
        table="An_Animal_Sinonimo"
        lazy="true"
    >

        <id
            name="id"
            column="id"
            type="java.lang.Long"
        >
            <generator class="native">
                <param name="sequence">gen_an_animal_sinonimo</param>
              <!--  
                  To add non XDoclet generator parameters, create a file named 
                  hibernate-generator-params-AnimalSinonimo.xml 
                  containing the additional parameters and place it in your merge dir. 
              --> 
            </generator>
        </id>

        <discriminator
            column="esHembra"
            type="boolean"
        />

        <property
            name="nombre"
            type="java.lang.String"
            update="true"
            insert="true"
        >
            <column
                name="nombre" 
                length="60"
            />
        </property>

        <property
            name="categoria"
            type="java.lang.String"
            update="true"
            insert="true"
        >
            <column
                name="categoria" 
                length="4"
            />
        </property>


        <property
            name="RP"
            type="java.lang.String"
            update="true"
            insert="true"
        >
            <column
                name="rP" 
                length="12"
            />
        </property>
		<property
            name="rpSenasa"
            type="java.lang.String"
            update="true"
            insert="true"
        >
            <column
                name="RP_SENASA" 
                length="12"
            />
        </property>
        <property
            name="codigoVerificador"
            type="java.lang.Integer"
            update="true"
            insert="true"
        >
            <column
            	name="CODIGO_VERIF_SENASA"
            	not-null="false"            	
        	/>
        </property>
        <property
            name="fechaNac"
            type="java.util.Date"
            update="true"
            insert="true"
            column="fnac"
        />
        
        <property
            name="nroLactancia"
            type="java.lang.Integer"
            update="true"
            insert="true"
        >
            <column
            	name="nroLactancia"
            	not-null="false"            	
        	/>
        </property> 

<!--        <property
            name="esActivo"
            type="java.lang.Boolean"
