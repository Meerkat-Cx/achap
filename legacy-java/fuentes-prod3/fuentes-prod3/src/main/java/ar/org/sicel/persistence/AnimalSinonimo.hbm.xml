            type="java.lang.Boolean"
            update="true"
            insert="true"
        >
            <column
                name="esBaja" 
                not-null="true"
            />
        </property>-->

        <property
            name="categoriaV3"
            type="java.lang.String"
            update="true"
            insert="true"
        >
            <column
                name="categoriaV3" 
                length="4"
            />
        </property>

 <property
            name="taraG"
            type="java.lang.String"
            update="true"
            insert="true"
        >
            <column
                name="taraG" 
                length="45"
            />
        </property>


        <property
            name="SRAFesb"
            type="java.util.Date"
            update="true"
            insert="true"
