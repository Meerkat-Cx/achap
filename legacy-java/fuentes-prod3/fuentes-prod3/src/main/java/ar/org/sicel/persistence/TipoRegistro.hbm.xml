<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping
>
    <class
        name="ar.org.sicel.persistence.TipoRegistro"
        table="An_Tipo_Registro"
        lazy="true"
    >

        <id
            name="id"
            type="java.lang.String"
        >
                <column
                    name="id" 
                    length="8"
                    not-null="true"
                />
            <generator class="assigned">
              <!--  
                  To add non XDoclet generator parameters, create a file named 
                  hibernate-generator-params-TipoRegistro.xml 
                  containing the additional parameters and place it in your merge dir. 
              --> 
            </generator>
        </id>

        <property
            name="descripcion"
            type="java.lang.String"
            update="true"
            insert="true"
        >
            <column
                name="descripcion" 
                length="40"
                not-null="true"
            />
        </property>

        <property
            name="numero"
            type="java.lang.Long"
            update="true"
            insert="true"
            column="numero"
        />

        <!--<property
            name="prioridad_id"
            type="java.lang.Integer"
            update="true"
            insert="true"
            column="prioridad_id"
        />

        <property
            name="prioridad_ori"
            type="java.lang.Integer"
            update="true"
            insert="true"
            column="prioridad_ori"
        />-->

        <!--
            To add non XDoclet property mappings, create a file named
                hibernate-properties-TipoRegistro.xml
            containing the additional properties and place it in your merge dir.
        -->

    </class>

</hibernate-mapping>
