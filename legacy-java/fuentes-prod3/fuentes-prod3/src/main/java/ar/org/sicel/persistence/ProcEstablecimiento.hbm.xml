<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping
>
    <class
        name="ar.org.sicel.persistence.ProcEstablecimiento"
        table="Pr_Establecimiento"
        lazy="true"
    >

        <id
            name="id"
            column="id"
            type="java.lang.Long"
        >
            <generator class="native">
                <param name="sequence">gen_pr_establecimiento</param>
              <!--  
                  To add non XDoclet generator parameters, create a file named 
                  hibernate-generator-params-ProcEstablecimiento.xml 
                  containing the additional parameters and place it in your merge dir. 
              --> 
            </generator>
        </id>

        <set
            name="procMsgsses"
            table="Pr_MsgEstab"
            lazy="true"
            cascade="all"
            sort="unsorted"
        >

            <key
                column="pr_estab"
                  foreign-key="FK_Pr_mest_pres"
            >
            </key>

            <many-to-many
                class="ar.org.sicel.persistence.ProcMsg"
                column="msg"
                outer-join="auto"
                foreign-key="FK_Pr_mest_msg"
             />

        </set>

        <many-to-one
            name="establecimiento"
            class="ar.org.sicel.persistence.Establecimiento"
            cascade="none"
            outer-join="auto"
            update="true"
            insert="true"
            foreign-key="FK_Pr_esta_Esta"
            column="establecimiento"
            not-null="true"
        />

        <many-to-one
            name="procLote"
            class="ar.org.sicel.persistence.ProcLote"
            cascade="none"
            outer-join="auto"
            update="true"
            insert="true"
            foreign-key="FK_Pr_esta_Lote"
            column="lote"
            not-null="true"
        />

        <set
            name="procAnimals"
            lazy="true"
            inverse="true"
            cascade="all"
            sort="unsorted"
        >

            <key
                column="pr_estab"
            >
            </key>

            <one-to-many
                  class="ar.org.sicel.persistence.ProcAnimal"
            />

        </set>

        <set
            name="procEvtEsts"
            lazy="true"
            inverse="true"
            cascade="all"
            sort="unsorted"
        >

            <key
                column="pr_estab"
            >
            </key>

            <one-to-many
                  class="ar.org.sicel.persistence.ProcEvtEst"
            />

        </set>

        <!--
            To add non XDoclet property mappings, create a file named
                hibernate-properties-ProcEstablecimiento.xml
            containing the additional properties and place it in your merge dir.
        -->

    </class>

</hibernate-mapping>
