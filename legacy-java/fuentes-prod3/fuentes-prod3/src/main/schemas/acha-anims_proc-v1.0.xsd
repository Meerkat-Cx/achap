<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<xs:element name="anims-modificados">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="informante" type="xs:long"/>
				<xs:element name="IDLoteInte" type="xs:long"/>
				<xs:element name="IDLoteSicel" type="xs:long"/>
				<xs:element name="anims" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="animal" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="IDAnim" type="STIdAnimal">
											<xs:annotation>
												<xs:documentation>si bien el evt alta o semen no lleva el anim, luego del proceso deberia tener el nuevo anim o el anim del semen</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="reg" type="TAnimReg" minOccurs="0"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="TAnimReg">
		<xs:annotation>
			<xs:documentation>Identificación de un animal por alguno de sus registros. Se debe indicar Tipo de registro (ver STTReg) y número</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="raza" type="STRaza" minOccurs="0"/>
			<xs:element name="pais" type="STPais" minOccurs="0"/>
			<xs:element ref="sexo" minOccurs="0"/>
			<xs:element name="tReg" type="STTReg" minOccurs="0"/>
			<xs:element name="nReg" type="STNReg"/>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="STRaza">
		<xs:annotation>
			<xs:documentation>Raza de un animal.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="H">
				<xs:annotation>
					<xs:documentation>Holando argentino</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="STPais">
		<xs:annotation>
			<xs:documentation>Pais de un registro de un animal.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AR">
				<xs:annotation>
					<xs:documentation>ISO country code de Argentina</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="STIdAnimal">
		<xs:annotation>
			<xs:documentation>Id del animal en la base de Sicel en ACHA</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:long"/>
	</xs:simpleType>
	<xs:simpleType name="STTReg">
		<xs:annotation>
			<xs:documentation>Tipos de registro</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="P">
				<xs:annotation>
					<xs:documentation>pedigri</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="C">
				<xs:annotation>
					<xs:documentation>registro de ACHA</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="STNReg">
		<xs:annotation>
			<xs:documentation>Número de registro</xs:documentation>
			<xs:documentation>TODO pattern que diga q no se puede espacios o ceros delante</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>
	<xs:simpleType name="STSexo">
		<xs:annotation>
			<xs:documentation>Sexo de un registro de un animal segun ISO</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="M">
				<xs:annotation>
					<xs:documentation>Male, macho</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="F">
				<xs:annotation>
					<xs:documentation>Female, hembra</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:element name="sexo" type="STSexo"/>
</xs:schema>
